.event-card {
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 18rpx 48rpx rgba(89, 63, 36, 0.06);
  margin-bottom: 24rpx;
}
.thumb { position: relative; overflow: hidden; background: #e8d9bf; }
.catalog .thumb { width: 100%; height: 0; padding-bottom: 56.25%; }
.thumb-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.thumb-shade {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(38, 31, 24, 0.04), rgba(38, 31, 24, 0.72));
}
.thumb-copy { position: absolute; left: 28rpx; right: 110rpx; bottom: 26rpx; z-index: 2; color: #fffaf2; }
.thumb-small { display: block; opacity: 0.88; font-size: 24rpx; margin-bottom: 10rpx; }
.thumb-title { display: block; font-size: 44rpx; line-height: 1.1; font-weight: 900; }
.waterfall .thumb-copy { left: 22rpx; right: 22rpx; bottom: 20rpx; }
.waterfall .thumb-title { font-size: 34rpx; }
.thumb-art { position: absolute; right: 22rpx; bottom: 12rpx; z-index: 2; }
.waterfall .thumb-art { top: 16rpx; bottom: auto; right: 16rpx; }

.body { padding: 32rpx 36rpx 36rpx; }
.waterfall .body { padding: 24rpx; }
.title { margin-top: 10rpx; font-size: 38rpx; font-weight: 900; }
.desc { margin-top: 12rpx; color: var(--muted); font-size: 28rpx; line-height: 1.65; }
.waterfall .desc { font-size: 24rpx; line-height: 1.6; }
.foot { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; }
.catalog .join { min-width: 236rpx; }
.waterfall .foot { flex-direction: column; align-items: flex-start; }
.waterfall .join { width: 100%; margin-top: 16rpx; }
/* 窄列：标签整块换行，不在标签内部断字 */
.waterfall .insight { font-size: 22rpx; padding: 8rpx 12rpx; margin: 0 8rpx 8rpx 0; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }

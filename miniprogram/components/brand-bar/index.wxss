.brand-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  background: rgba(248, 240, 228, 0.96);
}
.brand-inner { display: flex; align-items: center; justify-content: space-between; padding-left: 36rpx; }
.brand-lockup { display: flex; align-items: center; }
.brand-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  padding: 6rpx;
  margin-right: 18rpx;
  background: var(--olive-dark);
  overflow: hidden;
  box-shadow: 0 12rpx 24rpx rgba(102, 114, 63, 0.2);
}
.brand-mark image { width: 100%; height: 100%; }
.brand-name { font-weight: 900; letter-spacing: 0.04em; font-size: 34rpx; line-height: 1.2; }
.brand-sub { color: var(--muted); font-size: 22rpx; }
.me-btn {
  width: 68rpx;
  height: 68rpx;
  border: 2rpx solid var(--line);
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.84);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.me-icon { width: 36rpx; height: 36rpx; }
.me-avatar { width: 100%; height: 100%; }

.hero {
  position: relative;
  min-height: 940rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--olive);
  box-shadow: var(--shadow);
}
.hero-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-shade {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(72, 58, 39, 0.84) 0%, rgba(72, 58, 39, 0.52) 42%, rgba(72, 58, 39, 0.06) 100%);
}
.hero-content {
  position: relative;
  z-index: 2;
  min-height: 940rpx;
  padding: 68rpx 48rpx 52rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.eyebrow { color: #f8e4b2; font-size: 24rpx; letter-spacing: 0.16em; font-weight: 800; }
.hero-title { margin-top: 24rpx; color: #fffaf2; font-size: 76rpx; line-height: 1.1; font-weight: 900; letter-spacing: -0.03em; max-width: 620rpx; }
.hero-lede { margin-top: 32rpx; color: rgba(255, 250, 242, 0.86); font-size: 30rpx; line-height: 1.7; max-width: 600rpx; }
.hero-actions { display: flex; }
.hero-actions .btn + .btn { margin-left: 20rpx; }
.stat-strip { margin-top: 36rpx; }
/* 每格约 183rpx 宽：收紧内边距、缩小字号，保证「视频赛事」一行放下 */
.stat-strip .stat { padding: 20rpx 16rpx; }
.stat-strip .stat-value { font-size: 32rpx; white-space: nowrap; }
.stat-strip .stat-label { font-size: 22rpx; line-height: 1.4; margin-top: 10rpx; }

/* 容器类名不能用 waterfall：event-card 开了 addGlobalClass，页面里的 .waterfall 会套到卡片根节点上 */
.home-waterfall { display: flex; align-items: flex-start; }
.home-waterfall .col { flex: 1; min-width: 0; }
.home-waterfall .col + .col { margin-left: 24rpx; }

.reward-card {
  position: relative;
  overflow: hidden;
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  padding: 28rpx;
  background: linear-gradient(145deg, #fffaf2, #f0dfc5);
}
.reward-visual { height: 208rpx; margin: -8rpx -8rpx 0; overflow: hidden; border-radius: 28rpx; background: #eee0ca; }
.reward-visual image { width: 100%; height: 100%; }
.reward-name { margin-top: 24rpx; font-size: 30rpx; font-weight: 800; }
.reward-desc { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.45; }
.reward-price { display: flex; align-items: center; margin-top: 22rpx; color: var(--orange); font-size: 24rpx; font-weight: 900; }
.reward-price .ico { width: 30rpx; height: 30rpx; margin-right: 10rpx; }

.summary { margin-top: 32rpx; }
.summary .stat { min-height: 148rpx; }
.sub-head { margin-top: 48rpx; }

.category-card {
  position: relative;
  min-height: 232rpx;
  border-radius: 36rpx;
  overflow: hidden;
  padding: 28rpx;
  color: #fffaf2;
  background: #8b7a5c;
  box-shadow: 0 20rpx 52rpx rgba(89, 63, 36, 0.12);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.category-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.category-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(38,31,24,0.08), rgba(38,31,24,0.72)); }
.category-badge { position: absolute; right: 18rpx; top: 14rpx; }
.category-copy { position: relative; z-index: 1; }
.category-name { font-size: 36rpx; font-weight: 900; }
.category-note { margin-top: 10rpx; font-size: 24rpx; color: rgba(255, 250, 242, 0.85); }

.tools { margin-top: 36rpx; padding-top: 8rpx; }
.catalog-count { margin-top: 20rpx; color: var(--muted); font-size: 24rpx; }
.catalog { margin-top: 32rpx; }

.video-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
}
.video-cover { position: relative; width: 256rpx; min-height: 208rpx; border-radius: 26rpx; overflow: hidden; flex: 0 0 auto; background: #e8d9bf; }
.video-cover image { position: absolute; width: 100%; height: 100%; }
.play {
  position: absolute; left: 50%; top: 50%;
  width: 68rpx; height: 68rpx; margin: -34rpx 0 0 -34rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fffaf2; background: rgba(48, 38, 28, 0.7); font-size: 26rpx;
}
.video-info { flex: 1; min-width: 0; margin-left: 24rpx; }
.video-title { font-size: 30rpx; line-height: 1.3; font-weight: 800; }
.video-desc { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.video-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.video-source { color: var(--olive-dark); font-size: 24rpx; font-weight: 800; flex: 1; min-width: 0; margin-right: 12rpx; }
.source-link { color: var(--orange); font-size: 24rpx; font-weight: 800; white-space: nowrap; }

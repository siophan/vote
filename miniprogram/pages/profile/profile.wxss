.avatar-block { display: flex; flex-direction: column; align-items: center; margin-top: 40rpx; }
.avatar-btn {
  width: 176rpx; height: 176rpx; padding: 0; margin: 0;
  border-radius: 56rpx; overflow: hidden;
  background: #efd4bd;
  display: flex; align-items: center; justify-content: center;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-ph { width: 80rpx; height: 80rpx; }
.avatar-tip { margin-top: 16rpx; color: var(--muted); font-size: 24rpx; }
.save { margin-top: 60rpx; }

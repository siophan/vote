.mall-grid { margin-top: 32rpx; }
.mall-card { background: var(--paper); border: 2rpx solid var(--line); border-radius: 36rpx; overflow: hidden; }
.mall-visual { height: 224rpx; background: linear-gradient(140deg, #e8d5ad, #f7e9d8); }
.mall-visual image { width: 100%; height: 100%; }
.mall-content { padding: 24rpx; }
.mall-name { font-size: 28rpx; font-weight: 800; }
.mall-desc { color: var(--muted); font-size: 24rpx; line-height: 1.4; margin-top: 10rpx; min-height: 62rpx; }
.mall-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.price { color: var(--orange); font-size: 26rpx; font-weight: 900; }

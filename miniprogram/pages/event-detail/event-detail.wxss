.page-wrap.plain { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.cover { position: relative; width: 100%; height: 0; padding-bottom: 62%; border-radius: var(--radius-xl); overflow: hidden; background: #e8d9bf; box-shadow: var(--shadow); margin-top: 12rpx; }
.cover-img { position: absolute; width: 100%; height: 100%; }
.cover-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(38,31,24,0.04), rgba(38,31,24,0.74)); }
.cover-badge { position: absolute; right: 24rpx; top: 20rpx; }
.cover-copy { position: absolute; left: 36rpx; right: 36rpx; bottom: 32rpx; color: #fffaf2; }
.cover-small { display: block; font-size: 24rpx; opacity: 0.88; margin-bottom: 10rpx; }
.cover-title { display: block; font-size: 52rpx; line-height: 1.1; font-weight: 900; }

.stats { margin-top: 24rpx; }
.stat-value.hot { color: var(--orange); }

.card { margin-top: 24rpx; padding: 32rpx; background: var(--paper); border: 2rpx solid var(--line); border-radius: var(--radius-lg); }
.desc { margin-top: 16rpx; font-size: 30rpx; line-height: 1.7; }

.steps-title { font-size: 32rpx; font-weight: 900; }
.step { display: flex; margin-top: 24rpx; }
.step-no { font-size: 36rpx; font-weight: 900; color: var(--orange); width: 72rpx; flex: 0 0 auto; line-height: 1.2; }
.step-name { display: block; font-size: 28rpx; font-weight: 800; }
.step-desc { display: block; margin-top: 6rpx; color: var(--muted); font-size: 24rpx; line-height: 1.55; }

.rank-avatar { margin-left: 16rpx; }

.action-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  display: flex;
  padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 242, 0.97);
  border-top: 2rpx solid var(--line);
}
.action-bar .btn { flex: 1; }
.action-bar .btn + .btn { margin-left: 18rpx; }
.action-bar .share { flex: 0 0 auto; padding: 0 30rpx; }

.video { width: 100%; height: 960rpx; border-radius: var(--radius-lg); overflow: hidden; margin-top: 12rpx; }
.player {
  margin-top: 12rpx;
  height: 420rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, #4b582c, #87935a 60%, #d97945);
  color: #fffaf2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}
.play-ico { width: 120rpx; height: 120rpx; }
.player-title { margin-top: 20rpx; font-size: 36rpx; font-weight: 900; }
.player-sub { margin-top: 10rpx; font-size: 24rpx; opacity: 0.8; }
.player-err { margin: 16rpx 32rpx 0; font-size: 22rpx; opacity: 0.9; text-align: center; word-break: break-all; }

.card { margin-top: 24rpx; padding: 32rpx; background: var(--paper); border: 2rpx solid var(--line); border-radius: var(--radius-lg); }
.title { font-size: 40rpx; font-weight: 900; flex: 1; margin-right: 16rpx; }
.reject { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: #f8e2d8; color: #9d5139; font-size: 24rpx; }
.author { display: flex; align-items: center; margin-top: 28rpx; }
.author-main { flex: 1; min-width: 0; margin: 0 20rpx; }
.flower-total { text-align: right; }
.flower-total .flower-count { display: block; font-size: 34rpx; }
.flower-unit { font-size: 24rpx; color: var(--muted); }
.desc { margin-top: 24rpx; font-size: 28rpx; line-height: 1.7; }
.event-link, .link-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 22rpx 24rpx; border-radius: 24rpx; background: #f8ead4; font-size: 24rpx; color: var(--olive-dark); }
.link-row { background: #f5efe4; }
.link-row .ico { width: 32rpx; height: 32rpx; flex: 0 0 auto; margin-right: 12rpx; }
.link-text { flex: 1; min-width: 0; color: var(--muted); }
.go { color: var(--orange); font-weight: 800; margin-left: 16rpx; white-space: nowrap; }

.steps-title { font-size: 32rpx; font-weight: 900; }
.balance { color: var(--muted); font-size: 24rpx; }
.counts { margin: 28rpx 0; display: flex; }
.hint { margin-top: 18rpx; color: var(--muted); font-size: 24rpx; text-align: center; }
.share { margin-top: 28rpx; }

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  padding: 18rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(225, 207, 179, 0.9);
  background: rgba(255, 250, 242, 0.97);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9a8976;
  font-size: 24rpx;
  padding: 6rpx 0;
}
.tab-icon {
  width: 64rpx;
  height: 54rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}
.tab-icon image { width: 40rpx; height: 40rpx; }
.tab.active { color: #4b582c; font-weight: 900; }
.tab.active .tab-icon { background: #e7ead6; }

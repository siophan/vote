/* 龄花里设计变量 —— 来自 ui/dist/index.html，尺寸按 375 设计稿 ×2 换算为 rpx */
page {
  --ink: #3c3029;
  --muted: #78685b;
  --cream: #f8f0e4;
  --paper: #fffaf2;
  --paper-deep: #f0e2ca;
  --olive: #66723f;
  --olive-dark: #4b582c;
  --orange: #d97945;
  --orange-soft: #f2d1bb;
  --line: #e6d5b9;
  --shadow: 0 36rpx 100rpx rgba(89, 63, 36, 0.1);
  --radius-xl: 56rpx;
  --radius-lg: 40rpx;
  --radius-md: 28rpx;

  background: var(--cream);
  color: var(--ink);
  font-family: "PingFang SC", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 28rpx;
  line-height: 1.4;
}

view, text, image, button, input, textarea, scroll-view { box-sizing: border-box; }
image { display: block; }

/* 页面容器：底部给自定义 tabBar 留位置 */
.page-wrap { padding: 16rpx 36rpx 0; }
.page-wrap.with-tab { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
.page-wrap.plain { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }

/* 按钮 —— 重置原生 button 样式 */
button::after { border: 0; }
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  min-height: 92rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  font-weight: 800;
  font-size: 28rpx;
  line-height: 1;
  background: transparent;
  width: auto;
}
.btn-hover { transform: translateY(2rpx) scale(0.98); opacity: 0.92; }
.btn-primary { background: var(--orange); color: #fffaf2; box-shadow: 0 20rpx 36rpx rgba(217, 121, 69, 0.28); }
.btn-ghost { background: rgba(255, 250, 242, 0.16); border-color: rgba(255, 250, 242, 0.42); color: #fffaf2; }
.btn-olive { background: var(--olive); color: #fffaf2; }
.btn-outline { border-color: var(--line); background: var(--paper); color: var(--olive-dark); }
.btn-small { min-height: 72rpx; padding: 0 26rpx; font-size: 24rpx; }
.btn-block { display: flex; width: 100%; }
/* 微信内置 button:not([size=mini]) { width: 184px } 优先级高于 .btn。
   这里用同等优先级 (0,1,1)、靠书写顺序覆盖回内容宽度；页面里 `.xx .btn` 这类两级选择器仍能再改宽度 */
button.btn { width: auto; }
button.btn-block { width: 100%; }
.btn[disabled] { opacity: 0.5; }
.btn-primary[disabled] { background: var(--orange); color: #fffaf2; }
.btn-olive[disabled] { background: var(--olive); color: #fffaf2; }

/* 区块标题 */
.section { margin-top: 60rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28rpx; }
.section-head > view:first-child { flex: 1; min-width: 0; margin-right: 24rpx; }
.page-head { margin-top: 28rpx; }
.section-title { font-size: 46rpx; line-height: 1.1; font-weight: 900; letter-spacing: -0.03em; }
.section-note { margin-top: 6rpx; color: var(--muted); font-size: 26rpx; line-height: 1.5; }
.text-link { color: var(--orange); font-size: 26rpx; font-weight: 800; padding: 8rpx 0; }
.head-actions { display: flex; align-items: center; }
.head-actions .btn + .btn { margin-left: 14rpx; }

/* 数据小卡 */
.stat { background: rgba(255, 250, 242, 0.76); border: 2rpx solid var(--line); border-radius: 32rpx; padding: 24rpx; }
.stat-value { display: block; font-size: 42rpx; color: var(--olive-dark); line-height: 1; font-weight: 900; }
.stat-label { display: block; color: var(--muted); font-size: 24rpx; margin-top: 12rpx; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }

/* 筛选 chip */
.chip-scroll { white-space: nowrap; width: 100%; }
.chip {
  display: inline-block;
  border: 2rpx solid var(--line);
  background: rgba(255, 250, 242, 0.72);
  color: var(--muted);
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 24rpx;
  line-height: 1;
  margin-right: 16rpx;
}
.chip.active { background: var(--olive); border-color: var(--olive); color: #fffaf2; }

/* 赛事数据标签 */
.insights { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.insight {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: #f5efe4;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.2;
}
.insight .strong { color: var(--olive-dark); font-weight: 800; margin-left: 6rpx; }
.insight.is-hot { background: #fff0df; color: var(--orange); }
.insight.is-hot .strong { color: var(--orange); }
.insight.is-ai { background: #ecf4df; color: var(--olive-dark); }

.meta-row { display: flex; flex-wrap: wrap; color: var(--muted); font-size: 24rpx; }
.meta-row > text { margin-right: 16rpx; }

.reward-strip {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #f8ead4;
  color: var(--olive-dark);
  font-size: 24rpx;
  line-height: 1.45;
}
.reward-strip .ico { width: 32rpx; height: 32rpx; flex: 0 0 auto; margin-right: 14rpx; }
.reward-strip .strong { color: var(--orange); font-weight: 800; }

.flower-count { color: var(--orange); font-weight: 900; font-size: 28rpx; }

/* 普通卡片 */
.mini-card {
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  min-height: 276rpx;
  text-align: left;
}
.mini-icon { width: 56rpx; height: 56rpx; }
.mini-num { font-size: 44rpx; font-weight: 900; color: var(--olive-dark); line-height: 1; }
.mini-title { display: block; margin-top: 24rpx; font-size: 30rpx; font-weight: 800; }
.mini-desc { display: block; margin-top: 10rpx; color: var(--muted); font-size: 26rpx; line-height: 1.55; }

/* 绿色资料卡 */
.profile-card { padding: 38rpx; border-radius: var(--radius-xl); background: var(--olive); color: #fffaf2; box-shadow: var(--shadow); }
.profile-card.soft { background: linear-gradient(135deg, var(--olive), #87935a); }
.profile-top { display: flex; justify-content: space-between; align-items: flex-start; }
.profile-name { font-size: 40rpx; font-weight: 900; }
.profile-sub { color: rgba(255, 250, 242, 0.7); font-size: 24rpx; margin-top: 10rpx; }
.flower-balance { text-align: right; flex: 0 0 auto; margin-left: 28rpx; }
.flower-balance .label { display: block; color: rgba(255, 250, 242, 0.7); font-size: 24rpx; }
.flower-balance .value { display: block; margin-top: 8rpx; font-size: 60rpx; line-height: 1; font-weight: 900; }
.flower-balance .unit { font-size: 24rpx; margin-left: 6rpx; color: rgba(255, 250, 242, 0.75); }
.progress { height: 16rpx; background: rgba(255, 250, 242, 0.2); border-radius: 999rpx; overflow: hidden; margin-top: 44rpx; }
.progress-bar { height: 100%; background: #f4bf67; border-radius: 999rpx; }
.milestone { display: flex; justify-content: space-between; color: rgba(255, 250, 242, 0.75); font-size: 24rpx; margin-top: 16rpx; }

/* 榜单 */
.rank-item { display: flex; align-items: center; padding: 24rpx; margin-bottom: 18rpx; background: var(--paper); border: 2rpx solid var(--line); border-radius: 32rpx; }
.rank-no { width: 52rpx; height: 52rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--paper-deep); color: var(--olive-dark); font-weight: 900; font-size: 24rpx; flex: 0 0 auto; }
.rank-no.first { background: var(--orange); color: #fff; }
.avatar { width: 84rpx; height: 84rpx; border-radius: 28rpx; background: #efd4bd; flex: 0 0 auto; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.avatar image { width: 100%; height: 100%; }
.avatar .ico { width: 44rpx; height: 44rpx; }
.rank-main { min-width: 0; flex: 1; margin: 0 20rpx; }
.rank-name { display: block; font-size: 28rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rank-sub { display: block; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rank-score { color: var(--orange); font-size: 26rpx; font-weight: 900; white-space: nowrap; margin-right: 16rpx; }

/* 列表行（订单 / 作品 / 账本） */
.list-card { background: var(--paper); border: 2rpx solid var(--line); border-radius: 32rpx; padding: 28rpx; margin-bottom: 20rpx; }
.list-row { display: flex; align-items: center; justify-content: space-between; }
.list-title { font-size: 30rpx; font-weight: 800; }
.list-sub { color: var(--muted); font-size: 24rpx; margin-top: 8rpx; line-height: 1.5; }
.tag { display: inline-block; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; background: #f5efe4; color: var(--muted); white-space: nowrap; }
.tag.ok { background: #e8f0d8; color: var(--olive-dark); }
.tag.wait { background: #fff0df; color: var(--orange); }
.tag.bad { background: #f8e2d8; color: #9d5139; }

.note-box { margin-top: 24rpx; padding: 24rpx 28rpx; border-radius: 28rpx; background: rgba(239, 229, 210, 0.72); color: var(--muted); font-size: 24rpx; line-height: 1.6; }

/* 表单 */
.field { margin-top: 28rpx; }
.field-label { display: block; color: var(--muted); font-size: 24rpx; margin-bottom: 12rpx; font-weight: 700; }
.input, .picker-box, .textarea {
  width: 100%;
  min-height: 92rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 26rpx;
  color: var(--ink);
  background: var(--paper);
  font-size: 28rpx;
  display: flex;
  align-items: center;
}
.textarea { height: 180rpx; padding: 22rpx 24rpx; display: block; }
.picker-box .placeholder, .placeholder { color: #b5a593; }
.picker-box .ico { width: 28rpx; height: 28rpx; margin-left: auto; }

.empty { padding: 60rpx 24rpx; color: var(--muted); text-align: center; font-size: 26rpx; }
.loading-more { padding: 28rpx; color: var(--muted); text-align: center; font-size: 24rpx; }

.ico { width: 36rpx; height: 36rpx; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

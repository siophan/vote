{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "/opt/homebrew/bin/uv",
      "runtimeArgs": ["run", "--directory", "server", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "ui-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "ui/dist"],
      "port": 8765
    }
  ]
}
